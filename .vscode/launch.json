{
  // "Server und Oberfläche" starts both; start the database first:
  // docker compose -f docker-compose.dev.yml up -d (see README, Development)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:server",
      "cwd": "${workspaceFolder}/admin",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Oberfläche",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:web",
      "cwd": "${workspaceFolder}/admin"
    }
  ],
  "compounds": [
    {
      "name": "Server und Oberfläche",
      "configurations": ["Server", "Oberfläche"],
      "stopAll": true
    }
  ]
}
