# Lokale Entwicklung: nach .env kopieren – "npm run dev:server" liest sie.
# Die Datenbank startet compose.dev.yaml im Hauptordner des Repos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=craftapps
DB_USER=craftapps
DB_PASSWORD=craftapps-dev
# Installierte Apps und Icons; der Ordner wird beim Start angelegt
DATA_DIR=./data
# Erstes Konto, wird nur angelegt, solange es noch keinen Benutzer gibt
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=admin-lokal-123
# Optional: ohne Token erlaubt GitHub 60 Anfragen pro Stunde
# GITHUB_TOKEN=github_pat_...
