# Local development: copy to .env – "npm run dev:server" reads it.
# The database is started by compose.dev.yaml in the repo root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=craftapps
DB_USER=craftapps
DB_PASSWORD=craftapps-dev
# Installed apps and icons; the folder is created on startup
DATA_DIR=./data
# First account, only created while there is no user yet
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=admin-lokal-123
# Optional: without a token GitHub allows 60 requests per hour
# GITHUB_TOKEN=github_pat_...
